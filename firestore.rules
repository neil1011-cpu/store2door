rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid)) ||
        request.auth.token.email == "admin@neilussolutions.com"
      );
    }

    // User Profiles: Owners have full control, Admins can read for logistics
    match /users/{userId} {
       allow read, write: if isSignedIn() && request.auth.uid == userId;
       allow read: if isAdmin();
       
       match /pre_alerts/{id} {
         allow read, write: if isSignedIn() && request.auth.uid == userId;
         allow read, write: if isAdmin();
       }
       
       match /shipments/{id} {
         allow read, write: if isSignedIn() && request.auth.uid == userId;
         allow read, write: if isAdmin();
       }
    }

    // Administrative Metadata - Strictly Protected
    match /metadata/{document=**} {
      // SMTP/Logicware configs are NEVER accessible to users
      allow read, write: if isAdmin();
      
      // Mailbox counter is accessible for registration handshake
      match /mailboxCounter {
        allow read, write: if isSignedIn();
      }
    }

    // Collection Group Rules for Dashboard Monitoring
    match /{path=**}/pre_alerts/{id} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/shipments/{id} {
       allow read: if isAdmin(); 
    }

    // Global Finance Ledger
    match /transactions/{id} {
      allow read, write: if isAdmin();
    }
    
    match /admin_roles/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sent_emails/{id} {
      allow read, write: if isAdmin();
    }
    
    match /invoices/{id} {
      // Users can see their own invoices, Admins see all
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    
    match /system_logs/{id} {
      allow read, write: if isAdmin();
    }
  }
}
