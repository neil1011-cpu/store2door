rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid))
      );
    }

    // User Profiles: Owners have full control, Admins can read for logistics
    match /users/{userId} {
       allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
       allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
       
       match /pre_alerts/{id} {
         allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
       }
       
       match /shipments/{id} {
         allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
       }
    }

    // Administrative Metadata - Strictly Protected
    // This blocks non-admins from reading SMTP or Vultr keys
    match /metadata/{document=**} {
      allow read, write: if isAdmin();
      
      // Handshake exception for mailbox generation during sign-up
      match /mailboxCounter {
        allow read, write: if isSignedIn();
      }
    }

    // Support collection group queries for Admin Dashboards
    match /{path=**}/pre_alerts/{id} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/shipments/{id} {
       allow read: if isAdmin(); 
    }

    // Finance & Audit - Admin Only
    match /transactions/{id} {
      allow read, write: if isAdmin();
    }
    
    match /admin_roles/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sent_emails/{id} {
      allow read, write: if isAdmin();
    }
    
    match /invoices/{id} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    
    match /system_logs/{id} {
      allow read, write: if isAdmin();
    }
  }
}