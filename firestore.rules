rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Basic User Profile Rules - Absolute Ownership
    match /users/{userId} {
       allow read, write: if isSignedIn() && request.auth.uid == userId;
       
       match /{allSubcollections=**} {
         allow read, write: if isSignedIn() && request.auth.uid == userId;
       }
    }

    // Allow user onboarding counter handshake
    match /metadata/mailboxCounter {
      allow read, write: if isSignedIn();
    }
    
    // Explicit Collection Group Access for User Views
    match /{path=**}/pre_alerts/{id} {
      allow read: if isSignedIn() && resource.data.customerId == request.auth.uid;
      allow list: if isSignedIn() && request.query.filters.customerId == request.auth.uid;
    }
    
    match /{path=**}/shipments/{id} {
       allow read: if true; 
       allow list: if isSignedIn() && request.query.filters.customerId == request.auth.uid;
    }

    // Global Admin Override
    match /{allPaths=**} {
      allow read, write: if isSignedIn() && (
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid)) ||
        request.auth.token.email == "admin@neilussolutions.com"
      );
    }
  }
}