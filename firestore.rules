rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid)) ||
        request.auth.token.email == "admin@neilussolutions.com"
      );
    }

    // Explicit User Profile Rules
    match /users/{userId} {
       allow read, write: if isSignedIn() && request.auth.uid == userId;
       
       match /pre_alerts/{id} {
         allow read, write: if isSignedIn() && request.auth.uid == userId;
       }
       
       match /shipments/{id} {
         allow read, write: if isSignedIn() && request.auth.uid == userId;
       }
    }

    // Administrative Metadata - Strictly Protected
    match /metadata/{document=**} {
      // Users can only read the mailbox counter for signup
      allow read: if isSignedIn() && (isAdmin() || request.path[4] == 'mailboxCounter');
      allow write: if isAdmin() || (isSignedIn() && request.path[4] == 'mailboxCounter');
      
      // email_config is NEVER accessible to ordinary users
      match /email_config {
        allow read, write: if isAdmin();
      }
    }

    // Collection Group Rules for Admins
    match /{path=**}/pre_alerts/{id} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/shipments/{id} {
       allow read: if isAdmin(); 
    }

    // Global Collections
    match /transactions/{id} {
      allow read, write: if isAdmin();
    }
    
    match /admin_roles/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sent_emails/{id} {
      allow read, write: if isAdmin();
    }
    
    match /invoices/{id} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    
    match /system_logs/{id} {
      allow read, write: if isAdmin();
    }
  }
}
