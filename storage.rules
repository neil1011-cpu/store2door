
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Isolated folder for user documentation
    match /invoices/{userId}/{path=**} {
      // Owners can manage their own documents
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Administrators can review documentation for customs processing
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }
    
    // Global Fallback
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
