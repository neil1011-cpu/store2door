rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // UNIVERSAL INVOICE ACCESS PROTOCOL
    // Provides unambiguous access to user-specific folders
    match /invoices/{uid}/{allPaths=**} {
      
      // OWNER ACCESS: Full authority for the authenticated folder owner.
      allow read, write, list: if request.auth != null && request.auth.uid == uid;
      
      // ADMINISTRATIVE ACCESS: Read-only access for verified admins and custom roles.
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }

    // DEFAULT SECURITY: Deny all other access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
