rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Supporting Documents (Invoices, Receipts)
    match /invoices/{userId}/{fileName} {
      // Recursive match to allow metadata checks and file access
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Admins can read all documents for verification
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }

    // Global Catch-all Security
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}