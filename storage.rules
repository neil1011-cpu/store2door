rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // UNIVERSAL DOCUMENTATION ACCESS
    // Using a direct recursive match to ensure metadata handshakes and write operations pass instantly.
    match /invoices/{uid}/{allPaths=**} {
      
      // Authorized owner access (UID must match the folder)
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      // Administrative Access Fallback
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        request.auth.token.admin == true
      );
    }

    // Default Security: Deny all unmapped access for worldwide safety.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
