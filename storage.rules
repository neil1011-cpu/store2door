
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Explicit rule for the invoices directory
    // We use {userId} to capture the folder name and {allPaths=**} for recursive access
    match /invoices/{userId}/{allPaths=**} {
      
      // 1. Authenticated Owners: Absolute full access to their own subdirectory
      allow read, write, list: if request.auth != null && request.auth.uid == userId;
      
      // 2. Administrative Read: For customs review and warehouse processing
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }
    
    // Fallback: Deny all other unauthorized access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
