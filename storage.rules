rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Flattened matching pattern to resolve metadata handshake failures
    match /invoices/{userId}/{fileName} {
      // Owner Access
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Admin Access
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        request.auth.token.admin == true
      );
    }

    // Default Security: Deny all unmapped access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}