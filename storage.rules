
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // UNIVERSAL INVOICE PERMISSIONS
    // This rule allows the owner of the folder (uid) to perform all operations.
    // It also allows authorized administrators to read the files for customs processing.
    match /invoices/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }
    
    // Default Deny-All
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
