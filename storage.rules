rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User Documentation Path
    // Refactored to ensure absolute path matching and SDK handshake authorization
    match /invoices/{userId}/{fileName} {
      
      // Owner-based read/write access
      // Using direct segment match for highest performance and reliability
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Admin bypass for logistics review
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        request.auth.token.admin == true
      );
    }

    // Global Catch-all Security: Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}