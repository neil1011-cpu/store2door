
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // CONSOLIDATED INVOICE ACCESS
    // Grants full read/write access to the owner of the folder and authorized admins.
    // allPaths=** ensures that metadata checks and background operations are authorized.
    match /invoices/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.email == "admin@neilussolutions.com" ||
        firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }
    
    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
