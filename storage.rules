rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User Documentation Path
    // Flattened rules to prevent recursive shadow matching and ensure immediate metadata authorization
    match /invoices/{userId}/{fileName} {
      // Owner-based read/write access
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Admin bypass for logistics review
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }

    // Global Catch-all Security: Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
