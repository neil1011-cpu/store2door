rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // INVOICE STORAGE PROTOCOL - UNAMBIGUOUS MATCHING
    // Strictly binds the {uid} segment to request.auth.uid to resolve unauthorized errors.
    match /invoices/{uid}/{filename} {
      
      // OWNER AUTHORIZATION: Primary read/write/list for the authenticated folder owner.
      allow read, write, list: if request.auth != null && request.auth.uid == uid;
      
      // ADMINISTRATIVE ACCESS: Emergency/Process bypass for verified admins.
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }

    // DEFAULT SECURITY: Deny all other access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
