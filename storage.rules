rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Invoices / Supporting Documents
    match /invoices/{userId}/{fileName} {
      // Owners have full access to their folder
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Admins can view all documents
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }

    // Default Security
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
