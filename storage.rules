
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Standard rule for user-uploaded invoices
    match /invoices/{userId}/{allPaths=**} {
      // 1. Owners can read and write to their own folder
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // 2. Administrators can read all invoices for processing
      // We check for the specific master email or the presence of an admin role in firestore
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }
    
    // Fallback: Default to deny for any other path
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
