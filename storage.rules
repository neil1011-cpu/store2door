
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Standard rule for user-uploaded invoices and documentation
    match /invoices/{userId}/{allPaths=**} {
      // 1. Owners can read and write to their own isolated folder
      // The {userId} in the path must match the UID of the authenticated user
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // 2. Administrators can read all invoices for processing and customs clearance
      // We authorize access if the user is the master admin or has an admin_roles document
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }
    
    // Global Fallback: Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
