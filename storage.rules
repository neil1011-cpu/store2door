
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // DIRECT INVOICE ACCESS
    // Simple, non-nested match to ensure metadata handshakes pass instantly.
    match /invoices/{uid}/{filename} {
      
      // Authorized owner access
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      // Administrative fallback (Explicit email check is most reliable)
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        request.auth.token.admin == true
      );
    }

    // Default Security: Deny all unmapped access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
