
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // UNIVERSAL FOLDER-OWNER PERMISSION SET
    // Uses a simplified path match to ensure metadata handshakes are always authorized for the owner.
    match /invoices/{uid}/{allPaths=**} {
      
      // Full authority for the folder owner.
      allow read, write, list: if request.auth != null && request.auth.uid == uid;
      
      // Administrative fallback for customs verification.
      allow read: if request.auth != null && (
        request.auth.token.email == "admin@neilussolutions.com" ||
        firestore.exists(/databases/(default)/documents/admin_roles/$(request.auth.uid))
      );
    }

    // Default: Deny all other unmapped access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
